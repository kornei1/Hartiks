/* Modern light theme with purple accents.
   Intentionally avoids forcing sizes (no min-height/min-width on tabs/containers). */

QWidget {
    background-color: #f5f7fb;
    color: #222222;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
}

/* Tooltips */
QToolTip {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #d6d2ff;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Buttons */
QPushButton {
    background-color: #6c5ce7;
    color: #ffffff;
    border: 1px solid #6c5ce7;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton:hover { background-color: #7d6ee0; border-color: #7d6ee0; }
QPushButton:pressed { background-color: #584ad1; border-color: #584ad1; }
QPushButton:disabled { background-color: #e6e6ea; color: #9a9a9a; border-color: #e6e6ea; }

/* Line edits */
QLineEdit {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #dfe6f7;
    border-radius: 5px;
    padding: 6px 8px;
    selection-background-color: #6c5ce7;
    selection-color: #ffffff;
}
QLineEdit:focus { border: 1px solid #6c5ce7; }

/* Text areas */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #e6e8f2;
    border-radius: 5px;
    padding: 8px;
}
QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #6c5ce7; }

/* Combo boxes */
QComboBox {
    background-color: #ffffff;
    color: #222222;
    border: 1px solid #e0e6f5;
    border-radius: 5px;
    padding: 4px 8px;
}
QComboBox:focus { border: 1px solid #6c5ce7; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #222222;
    selection-background-color: #e6e0ff;
    selection-color: #222222;
}

/* Checkboxes & Radio */
QCheckBox, QRadioButton { color: #222222; }
QCheckBox::indicator, QRadioButton::indicator {
    border: 1px solid #cfd8ff;
    background: #ffffff;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #6c5ce7;
    border-color: #6c5ce7;
}

/* Sliders */
QSlider::groove:horizontal { height: 8px; background: #e8eaf6; border-radius: 4px; }
QSlider::handle:horizontal { width: 14px; background: #6c5ce7; border-radius: 7px; }
QSlider::groove:vertical { width: 8px; background: #e8eaf6; border-radius: 4px; }
QSlider::handle:vertical { height: 14px; background: #6c5ce7; border-radius: 7px; }

/* Scrollbars */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
}
QScrollBar::handle { background: #c9c6ff; border-radius: 6px; }
QScrollBar::handle:hover { background: #b3aefd; }

/* Progress bar */
QProgressBar {
    background-color: #ffffff;
    border: 1px solid #e6e8f2;
    border-radius: 5px;
    color: #222222;
}
QProgressBar::chunk { background-color: #6c5ce7; border-radius: 3px; }

/* Tabs - no forced size changes; keep default metrics */
QTabWidget::pane { border: 1px solid #e6e8f2; background: transparent; border-radius: 6px; }
QTabBar::tab {
    background: #f8f9fc;
    color: #222222;
    border: 1px solid #e6e8f2;
    padding: 6px 10px; /* small padding only, not changing overall layout */
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #222222;
    border-bottom-color: #ffffff;
}
QTabBar::tab:hover { background: #f0f1f7; }

/* Tables */
QTableWidget {
    background: #ffffff;
    gridline-color: #eef0fb;
    color: #222222;
    border: 1px solid #e6e8f2;
    border-radius: 5px;
}
QTableWidget::item:selected { background: #e6e0ff; color: #222222; }
QHeaderView::section { background: #f0f2fb; color: #222222; border: 1px solid #e6e8f2; }

/* Group boxes & labels */
QGroupBox { background: transparent; border: 1px solid #e6e8f2; border-radius: 6px; margin-top: 12px; padding-top: 10px; }
QGroupBox::title { color: #6c5ce7; padding: 0 6px; }
QLabel { color: #222222; }

/* Menus and toolbars */
QMenuBar { background: #f5f7fb; color: #222222; }
QMenu { background: #ffffff; color: #222222; border: 1px solid #e6e8f2; }
QToolBar { background: transparent; }

/* Custom object names */
#bgApp { background-color: #f5f7fb; border: 1px solid #e6e8f2; }
#leftMenuBg { background-color: #fafbff; border-right: 1px solid #e6e8f2; }
#contentTopBg { background-color: #ffffff; border-bottom: 1px solid #e6e8f2; }
#bottomBar { background-color: #fafbff; border-top: 1px solid #e6e8f2; }
#bottomBar QLabel { color: #6b6b6b; padding: 6px; }
